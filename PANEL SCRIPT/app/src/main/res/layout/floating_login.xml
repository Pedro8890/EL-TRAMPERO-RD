<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E61A1A1A"
    android:padding="12dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 EL TRAMPERO RD 🔥"
        android:textColor="#00FF66"
        android:textStyle="bold"
        android:textSize="15sp"
        android:gravity="center"
        android:paddingBottom="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACCESO VIP"
        android:textColor="#00FFFF"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingBottom="6dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginBottom="8dp"/>

    <!-- Sección ID -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="── ID ÚNICO ──"
        android:textColor="#FFA500"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <EditText
        android:id="@+id/et_id"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:hint="8 caracteres"
        android:inputType="textVisiblePassword"
        android:maxLength="8"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="13sp"
        android:background="#2A2A2A"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Sección Usuario -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="── USUARIO ──"
        android:textColor="#FFA500"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <EditText
        android:id="@+id/et_usuario"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:hint="8 caracteres"
        android:inputType="text"
        android:maxLength="8"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="13sp"
        android:background="#2A2A2A"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Sección Contraseña -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="── CONTRASEÑA ──"
        android:textColor="#FFA500"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:hint="8 caracteres"
        android:inputType="textPassword"
        android:maxLength="8"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="13sp"
        android:background="#2A2A2A"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginBottom="4dp"/>

    <!-- NUEVO: Botón para pegar -->
    <Button
        android:id="@+id/btn_pegar_login"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="📋 PEGAR DATOS"
        android:background="#CC003366"
        android:textColor="#00CCFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <!-- Botón Admin (Generar datos) -->
    <Button
        android:id="@+id/btn_abrir_admin_login"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="⚙ GENERAR DATOS (ADMIN)"
        android:background="#00000000"
        android:textColor="#777777"
        android:textSize="10sp"
        android:layout_marginBottom="6dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#00FFFF"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="4dp"/>

    <ProgressBar
        android:id="@+id/pb_login"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cerrar_login"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="✖ CERRAR"
            android:background="#CC880000"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="2"
            android:text="INGRESAR"
            android:background="#CC00AA44"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

</LinearLayout>