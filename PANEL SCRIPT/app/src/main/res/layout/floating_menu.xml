<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E61A1A1A"
    android:padding="10dp"
    android:elevation="8dp">

    <!-- ── Título (fijo, siempre visible) ── -->
    <TextView
        android:id="@+id/txt_tiempo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 EL TRAMPERO RD 🔥"
        android:textColor="#00FF66"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginBottom="2dp"/>

    <!-- ── Fecha de expiración VIP (desde cache) ── -->
    <TextView
        android:id="@+id/tv_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#666666"
        android:textSize="9sp"
        android:gravity="center"
        android:paddingBottom="2dp"
        android:visibility="gone"/>

    <!-- ── ProgressBar (fijo, siempre visible) ── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="4dp"/>

    <!-- ══════════════════════════════════════════
         ZONA SCROLLABLE — cabe en portrait y landscape
         Altura 240dp → suficiente para landscape (~360dp alto)
         sin cortar el título ni los botones
    ══════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── MIRAS ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="── MIRAS ──"
                android:textColor="#FFA500"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="4dp"/>

            <Switch
                android:id="@+id/switch_arana_"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="TRADICIONALES"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"/>

            <!-- ── COLORES ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="── COLORES ──"
                android:textColor="#FFA500"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="4dp"/>

            <Switch
                android:id="@+id/switch_colores_v1"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="BLANCO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="TRANSPARENTE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v3"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="NEGRO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v4"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="AZUL MARINO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v5"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="DINAMICO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v6"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="ROSA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"/>

            <!-- ── CIELO NEGRO ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="── CIELO NEGRO ──"
                android:textColor="#FFA500"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="4dp"/>

            <Switch
                android:id="@+id/switch_colores_v7"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="🗾 BERMUDA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="2dp"/>

            <Switch
                android:id="@+id/switch_colores_v8"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="🗺️ TODOS LOS MAPAS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingLeft="4dp"
                android:layout_marginBottom="4dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ── Botones (fijos, siempre visibles) ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cerrar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="4"
            android:text="✖ CERRAR"
            android:background="#CC880000"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btn_admin"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="⚙"
            android:background="#661A1A1A"
            android:textColor="#555555"
            android:textSize="13sp"/>

    </LinearLayout>

</LinearLayout>
