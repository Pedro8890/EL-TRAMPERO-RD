<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sysopt.displayservice">

    <!-- Overlay flotante (todas las API) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Foreground Service: requerido en API 28+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    
    <!-- Permiso para el tipo dataSync (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Notificación del servicio visible: requerido en API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        Excluir la app de la optimización de batería.
        Necesario en MIUI / ColorOS / Funtouch / One UI para que
        el ForegroundService no sea asesinado en segundo plano.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true">

        <service
            android:name=".FloatingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:label="@null"/>

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:excludeFromRecents="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

    </application>

</manifest>